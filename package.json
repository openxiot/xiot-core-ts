{
  "name": "xiot-core-ts",
  "version": "0.0.3",
  "private": true,
  "description": "Openxiot Core TypeScript",
  "author": "gkcity",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openxiot/xiot-core-ts"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "samples/node/*"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "clean": "pnpm -r clean",
    "build": "pnpm --filter @openxiot/xiot-core-spec-ts build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "prebuild": "pnpm --filter \"./packages/**\" install",
    "prepublish": "pnpm build",
    "publish:spec": "cd packages/xiot-core-spec-ts && pnpm publish --access public --no-git-checks",
    "publish:xcp": "cd packages/xiot-core-xcp-ts && pnpm publish --access public --no-git-checks",
    "publish:xcps": "cd packages/xiot-core-xcps-ts && pnpm publish --access public --no-git-checks",
    "publish:all": "pnpm run publish:spec && pnpm run publish:xcp",
    "version:check": "node -e \"const fs=require('fs');const v=JSON.parse(fs.readFileSync('package.json')).version;['packages/xiot-core-spec-ts','packages/xiot-core-xcp-ts','packages/xiot-core-xcps-ts'].forEach(p=>{const pv=JSON.parse(fs.readFileSync(p+'/package.json')).version;if(pv!==v)throw new Error(p+' version mismatch: '+pv+' vs '+v);});console.log('All versions match:',v)\"",
    "version:sync": "sync-version packages/*/package.json",
    "version:list": "sync-version --list packages/*/package.json"
  },
  "devDependencies": {
    "typescript": "^5.7.0 || ^5.8.0",
    "sync-version": "^1.1.0"
  }
}
